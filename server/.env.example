# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Single recipient (your personal chat with the bot):
TELEGRAM_CHAT_ID=123456789

# OR multiple recipients (comma-separated). Overrides TELEGRAM_CHAT_ID if set.
# Use a negative ID for a group chat (e.g. -1001234567890).
# TELEGRAM_CHAT_IDS=123456789,987654321,-1001234567890

PORT=3000
