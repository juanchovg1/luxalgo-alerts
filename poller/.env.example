# Absolute path to the tradingview-mcp CLI entrypoint.
# Default after cloning https://github.com/tradesdontlie/tradingview-mcp into your home folder.
# Use forward slashes even on Windows.
TV_CLI=C:/Users/YOURNAME/tradingview-mcp/src/cli/index.js

# Where to POST detected OBs. Should match the server's PORT.
ALERT_ENDPOINT=http://localhost:3000/alert

# Polling cadence in milliseconds. 5000 = every 5 seconds.
POLL_INTERVAL_MS=5000

# Color mapping for LuxAlgo SMC Order Block boxes.
# These are ARGB integer values returned by `tv data boxes -v`.
#
# DEFAULTS BELOW ARE FROM A SPECIFIC USER THEME — they will likely differ for you.
# To detect the right values for your theme:
#   1. Open TradingView Desktop with the LuxAlgo SMC indicator on a chart
#      that currently shows BOTH a green AND a red rectangle.
#   2. Run: node poller/index.js --inspect-colors
#   3. Run: node poller/analyze.js
#      (this classifies each color by position vs current price)
#   4. Update the two values below.
COLOR_BULLISH=1298726656
COLOR_BEARISH=1292370175

# If true, the first poll cycle indexes existing OBs as "already seen"
# (no Telegram spam at startup). Set to false to test the pipeline.
WARMUP_SKIP=true
